# LLM backend: mock, ollama, runyourai, openai, or anthropic.
HARMONET_LLM_BACKEND=mock

# Ollama local backend
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# External API backends. Keep real keys in a local .env file only.
RUNYOURAI_API_KEY=
RUNYOURAI_MODEL=anthropic/claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-5-mini-2025-08-07
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-haiku-4-5

# Optional runtime settings
HARMONET_LOG_LEVEL=INFO
HARMONET_API_TOKEN=
REDIS_URL=redis://localhost:6379/0

# ── 폴백 스위치 (WEEK1 A2). 설정하지 않으면 해당 의존성 부재/실패는 예외로 실행이 멈춘다 ──
# HARMONET_ALLOW_NO_REDIS=1        Redis 없이 로컬 인메모리 스토어로 진행 (경고 출력)
# HARMONET_ALLOW_OFFLINE_EMBED=1   임베딩 모델 로드 실패 시 해시 벡터로 진행 (의미 없는 벡터 — 벤치마크 금지)
# HARMONET_LLM_BACKEND=mock        MockLLM 은 이렇게 명시했을 때만 사용됨 (자동 Mock 폴백 없음)
