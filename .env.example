# LLM backend: mock, ollama, runyourai, openai, or anthropic.
HARMONET_LLM_BACKEND=mock

# Ollama local backend
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# External API backends. Keep real keys in a local .env file only.
RUNYOURAI_API_KEY=
RUNYOURAI_MODEL=anthropic/claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-5-mini-2025-08-07
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-haiku-4-5

# Optional runtime settings
HARMONET_LOG_LEVEL=INFO
HARMONET_API_TOKEN=
REDIS_URL=redis://localhost:6379/0
